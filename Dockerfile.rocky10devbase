FROM rockylinux/rockylinux:10

# ====================== 第一层：安装全套依赖 + 深度系统清理瘦身 ======================
RUN set -eux; \
    dnf clean all && dnf makecache && \
    dnf install -y epel-release && dnf makecache && \
    dnf install -y \
        git dos2unix tar gzip curl vim less procps-ng iproute iputils \
        openssh-clients openssh-server telnet \
        python3 python3-pip python3-devel \
        "@Development Tools" gcc gcc-c++ autoconf automake libtool gdb \
        ncurses-devel libpcap readline-devel libstdc++ libgcc \
        nodejs npm openssl-devel \
        glibc-langpack-en glibc-langpack-zh \
        unzip wqy-zenhei-fonts && \
    dnf clean all && \
    rm -rf /var/cache/dnf /usr/share/doc /usr/share/man /tmp/* /var/log/*

# 全局统一环境变量：时区、语言、IDE端口、Ollama内网AI地址
ENV \
    TZ=Asia/Shanghai \
    LANG=zh_CN.UTF-8 \
    LC_ALL=zh_CN.UTF-8 \
    CODE_PORT=8081 \
    PASSWORD="" \
    SSH_PORT=2222 \
    CODE_SERVER_BIND="0.0.0.0:${CODE_PORT}" \
    OLLAMA_HOST=http://127.0.0.1:11434

# ====================== 第三层：SSH配置、别名、启动脚本、printf写入配置、开启root密码登录 ======================
RUN set -eux; \
    mkdir -p /root/.ssh /root/.local/share/code-server/User && \
    chmod 700 /root/.ssh /root/.local/share/code-server && \
    echo "StrictHostKeyChecking no" >> /root/.ssh/config && \
    chmod 600 /root/.ssh/config && \
    echo "alias python=python3" >> /root/.bashrc && \
    echo "alias pip=pip3" >> /root/.bashrc && \
    echo '#!/bin/bash' > /usr/local/bin/start_sshd.sh && \
    echo 'SSH_LISTEN=${SSH_PORT:-2222}' >> /usr/local/bin/start_sshd.sh && \
    echo 'sed -i "s/^#Port 22/Port ${SSH_LISTEN}/" /etc/ssh/sshd_config' >> /usr/local/bin/start_sshd.sh && \
    echo 'exec /usr/sbin/sshd -D' >> /usr/local/bin/start_sshd.sh && \
    chmod +x /usr/local/bin/start_sshd.sh && \
    # printf写入格式化分行settings.json，使用占位符__OLLAMA_HOST__
    printf '{\n\
    "locale": "zh-cn",\n\
    "workbench.colorTheme": "Dark+ (default dark)",\n\
    "editor.fontSize": 14,\n\
    "editor.tabSize": 4,\n\
    "editor.insertSpaces": true,\n\
    "editor.formatOnSave": true,\n\
    "files.encoding": "utf8",\n\
    "files.eol": "\\\\n",\n\
    "terminal.integrated.defaultProfile.linux": "bash",\n\
    "C_Cpp.default.compilerPath": "/usr/bin/g++",\n\
    "C_Cpp.intelliSenseEngine": "default",\n\
    "cmake.sourceDirectory": "${workspaceFolder}",\n\
    "cmake.buildDirectory": "${workspaceFolder}/build",\n\
    "cmake.generator": "Unix Makefiles",\n\
    "python.defaultInterpreterPath": "/usr/bin/python3",\n\
    "python.formatting.provider": "autopep8",\n\
    "python.analysis.autoImportCompletions": true,\n\
    "extensions.ignoreRecommendations": true,\n\
    "workbench.startupEditor": "none",\n\
    "continue.defaultModel": "qwen",\n\
    "continue.ollama.baseUrl": "__OLLAMA_HOST__",\n\
    "continue.autoCompleteEnabled": true,\n\
    "continue.suggestionsEnabled": true,\n\
    "continue.chatShortcut": "ctrl+l",\n\
    "continue.indexingEnabled": true\n}\n' > /root/.local/share/code-server/User/settings.json && \
    # printf写入格式化keybindings.json
    printf '[{\n\
    "key": "ctrl+shift+b",\n\
    "command": "cmake.build"\n}]\n' > /root/.local/share/code-server/User/keybindings.json && \
    # 开启SSH root密码登录
    sed -i 's/^PermitRootLogin no/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#PasswordAuthentication no/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    # RockyLinux 使用chpasswd设置root密码
    ROOT_PWD=${PASSWORD:-Root@123456}; echo "root:${ROOT_PWD}" | chpasswd

# ====================== 第四层：安装 code-server + 插件 + Python依赖 + 三层中文锁定全集成 ======================
RUN set -eux; \
    curl --connect-timeout 15 --retry 3 -fsSL https://raw.githubusercontent.com/coder/code-server/main/install.sh -o /tmp/code-install.sh && \
    chmod +x /tmp/code-install.sh && \
    sh /tmp/code-install.sh && \
    code-server --install-extension ms-python.python && \
    code-server --install-extension ms-vscode.cmake-tools && \
    code-server --install-extension twxs.cmake && \
    code-server --install-extension llvm-vs-code-extensions.vscode-clangd && \
    code-server --install-extension continue.continue && \
    code-server --install-extension MS-CEINTL.vscode-language-pack-zh-hans && \
    code-server --locale zh-cn --list-extensions && \
    pip3 config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip3 install --upgrade pip pybind11 debugpy numpy ipython autopep8 && \
    # 备份完整配置模板
    cp -r /root/.local/share/code-server /root/.local/share/code-server.template && \
    # 启动脚本集成：storage.json + 补丁A Machine全局配置
    printf '#!/bin/bash\nTARGET_CONF=/root/.local/share/code-server\nOLLAMA_RUN_HOST=${OLLAMA_HOST:-http://127.0.0.1:11434}\n\n# 1. 空挂载拷贝模板并替换Ollama地址\nif [ -d "${TARGET_CONF}" ] && [ -z "$(ls -A "${TARGET_CONF}" 2>/dev/null)" ]; then\n    echo "初始化code-server默认配置（中文+黑色主题模板）"\n    cp -r /root/.local/share/code-server.template/* "${TARGET_CONF}/"\n    sed -i "s|__OLLAMA_HOST__|${OLLAMA_RUN_HOST}|g" "${TARGET_CONF}/User/settings.json"\nfi\n\n# 2. 第一层锁定：globalStorage/storage.json 最高优先级缓存覆盖\nSTORAGE_FILE="${TARGET_CONF}/User/globalStorage/storage.json"\nmkdir -p "${TARGET_CONF}/User/globalStorage"\nif [ -f "$STORAGE_FILE" ]; then\n    echo "检测到storage.json，强制替换locale为zh-cn"\n    sed -i '\''s/"locale":"en"/"locale":"zh-cn"/g'\'' "$STORAGE_FILE"\nelse\n    echo "新建storage.json，锁定默认中文zh-cn"\n    echo '\''{"locale":"zh-cn"}'\'' > "$STORAGE_FILE"\nfi\n\n# 3. 补丁A 第二层锁定：Machine机器级全局配置兜底
MACHINE_FILE="${TARGET_CONF}/Machine/settings.json"\nmkdir -p "${TARGET_CONF}/Machine"\necho "写入Machine全局配置锁定locale=zh-cn"\necho '\''{"locale":"zh-cn"}'\'' > "$MACHINE_FILE"\n\n# 启动code-server，双重环境变量+参数兜底
exec sh -c "VSCODE_NLS_CONFIG={\\\"locale\\\":\\\"zh-cn\\\"} code-server --auth none --bind-addr 0.0.0.0:${CODE_PORT} --locale zh-cn --log trace"\n' > /usr/local/bin/entrypoint-cs.sh && \
    chmod +x /usr/local/bin/entrypoint-cs.sh && \
    # 补丁B 第三层底层锁定：修复版精准修改product.json（仅替换文本、仅末尾追加，不破坏JSON结构）
    PROD_JSON=/usr/lib/code-server/lib/vscode/product.json; \
    if [ -f "$PROD_JSON" ]; then \
        # 替换已存在的英文locale字段
        sed -i -e 's/"defaultLocale": "en"/"defaultLocale": "zh-cn"/g' -e 's/"locale": "en"/"locale": "zh-cn"/g' "$PROD_JSON"; \
        # 不存在defaultLocale则仅在文件最后一行}前插入，不会破坏内层JSON
        if ! grep -q '"defaultLocale"' "$PROD_JSON"; then \
            sed -i '$ s/}/,"defaultLocale":"zh-cn"}/' "$PROD_JSON"; \
        fi; \
    fi; \
    # 清理构建缓存缩小镜像
    rm -rf /root/.cache/pip /root/.npm /tmp/* /tmp/code-install.sh

# 暴露端口
EXPOSE 2222 8081

WORKDIR /workspace

# 入口脚本
CMD ["/usr/local/bin/entrypoint-cs.sh"]
