FROM rockylinux/rockylinux:10

# ====================== 第一层：安装全套依赖 + 深度系统清理瘦身 ======================
RUN set -eux; \
    dnf clean all && dnf makecache && \
    dnf install -y epel-release && dnf makecache && \
    dnf install -y \
        git dos2unix tar gzip curl vim less procps-ng iproute iputils \
        openssh-clients openssh-server telnet \
        python3 python3-pip python3-devel \
        "@Development Tools" gcc gcc-c++ autoconf automake libtool \
        ncurses-devel libpcap readline-devel libstdc++ libgcc \
        nodejs npm openssl-devel \
        glibc-langpack-en glibc-langpack-zh \
        unzip && \
    dnf clean all && \
    rm -rf /var/cache/dnf /usr/share/doc /usr/share/man /tmp/* /var/log/*

# 全局统一环境变量：时区、语言、IDE端口、Ollama内网AI地址
ENV \
    TZ=Asia/Shanghai \
    LANG=zh_CN.UTF-8 \
    LC_ALL=zh_CN.UTF-8 \
    CODE_PORT=8081 \
    PASSWORD="" \
    SSH_PORT=2222 \
    CODE_SERVER_BIND="0.0.0.0:${CODE_PORT}" \
    OLLAMA_HOST=http://127.0.0.1:11434

# ====================== 第二层：安装固定稳定版 CMake（保持直连github不变） ======================
RUN set -eux; \
    curl --connect-timeout 15 --retry 3 -L -o cmake.tar.gz https://github.com/Kitware/CMake/releases/download/v3.31.3/cmake-3.31.3-linux-x86_64.tar.gz && \
    tar -zxf cmake.tar.gz -C /usr/local/ && \
    mv /usr/local/cmake-3.31.3-linux-x86_64 /usr/local/cmake && \
    rm -rf cmake.tar.gz

ENV PATH="/usr/local/cmake/bin:${PATH}"

# ====================== 第三层：SSH配置、别名、启动脚本、printf写入配置、开启root密码登录 ======================
RUN set -eux; \
    mkdir -p /root/.ssh /root/.local/share/code-server/User && \
    chmod 700 /root/.ssh /root/.local/share/code-server && \
    echo "StrictHostKeyChecking no" >> /root/.ssh/config && \
    chmod 600 /root/.ssh/config && \
    echo "alias python=python3" >> /root/.bashrc && \
    echo "alias pip=pip3" >> /root/.bashrc && \
    echo '#!/bin/bash' > /usr/local/bin/start_sshd.sh && \
    echo 'SSH_LISTEN=${SSH_PORT:-2222}' >> /usr/local/bin/start_sshd.sh && \
    echo 'sed -i "s/^#Port 22/Port ${SSH_LISTEN}/" /etc/ssh/sshd_config' >> /usr/local/bin/start_sshd.sh && \
    echo 'exec /usr/sbin/sshd -D' >> /usr/local/bin/start_sshd.sh && \
    chmod +x /usr/local/bin/start_sshd.sh && \
    # 修复printf %s格式化冲突，管道sed替换，消除shell字符串解析报错
    printf '{\
    "locale": "zh-cn",\
    "editor.fontSize": 14,\
    "editor.tabSize": 4,\
    "editor.insertSpaces": true,\
    "editor.formatOnSave": true,\
    "files.encoding": "utf8",\
    "files.eol": "\\n",\
    "terminal.integrated.defaultProfile.linux": "bash",\
    "C_Cpp.default.compilerPath": "/usr/bin/g++",\
    "C_Cpp.intelliSenseEngine": "default",\
    "cmake.sourceDirectory": "${workspaceFolder}",\
    "cmake.buildDirectory": "${workspaceFolder}/build",\
    "cmake.generator": "Unix Makefiles",\
    "python.defaultInterpreterPath": "/usr/bin/python3",\
    "python.formatting.provider": "autopep8",\
    "python.analysis.autoImportCompletions": true,\
    "extensions.ignoreRecommendations": true,\
    "workbench.startupEditor": "none",\
    "continue.defaultModel": "qwen",\
    "continue.ollama.baseUrl": "%s",\
    "continue.autoCompleteEnabled": true,\
    "continue.suggestionsEnabled": true,\
    "continue.chatShortcut": "ctrl+l",\
    "continue.indexingEnabled": true\
}\n' | sed "s|%s|${OLLAMA_HOST}|g" > /root/.local/share/code-server/User/settings.json && \
    # printf 写入 keybindings.json
    printf '[{\
    "key": "ctrl+shift+b",\
    "command": "cmake.build"\
}]\n' > /root/.local/share/code-server/User/keybindings.json && \
    # 开启SSH root密码登录
    sed -i 's/^PermitRootLogin no/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#PasswordAuthentication no/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    echo "Root@123456" | passwd --stdin root

# ====================== 第四层：安装 code-server + 开发插件 + Python依赖 + 缓存清理 ======================
RUN set -eux; \
    # 1. 下载并安装 code-server
    curl --connect-timeout 15 --retry 3 -fsSL https://raw.githubusercontent.com/coder/code-server/main/install.sh -o /tmp/code-install.sh && \
    chmod +x /tmp/code-install.sh && \
    sh /tmp/code-install.sh && \
    \
    # 2. 全部在线可正常安装插件，clangd替代微软cpptools
    code-server --install-extension ms-python.python && \
    code-server --install-extension ms-vscode.cmake-tools && \
    code-server --install-extension twxs.cmake && \
    code-server --install-extension llvm-vs-code-extensions.vscode-clangd && \
    code-server --install-extension continue.continue && \
    \
    # 3. 配置清华pip源，安装Python依赖
    pip3 config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip3 install --upgrade pip pybind11 debugpy numpy ipython autopep8 && \
    \
    # 4. 全局临时文件缓存清理
    rm -rf /root/.cache/pip /root/.npm /tmp/* /tmp/code-install.sh

# 移除无用11434端口暴露，仅保留ssh、code-server端口
EXPOSE 2222 8081

WORKDIR /workspace

# 修复：CMD数组无法解析变量，改用shell形式加载环境变量；原--auth none兼容PASSWORD空变量
CMD ["sh", "-c", "code-server --auth none --bind-addr 0.0.0.0:${CODE_PORT}"]
