# ============================================
# Jupyter AI v3.0 完整环境 Dockerfile
# ============================================
# 基于官方 Jupyter 镜像
FROM quay.io/jupyter/base-notebook:latest

# 设置维护者信息
LABEL maintainer="Jupyter AI Team"
LABEL description="Jupyter AI v3.0 with PyTorch, TensorFlow, LangChain, and Ollama support"

# 设置环境变量（构建时）
# 设置环境变量（可被覆盖）
ENV JUPYTER_PORT=8881
ENV JUPYTER_TOKEN=
ENV JUPYTER_PASSWORD=
ENV CONDA_ENV_NAME=ai_env
ENV PYTHON_VERSION=3.11
ENV JUPYTER_ENABLE_LAB=yes
ENV OLLAMA_HOST=http://192.168.112.136:11434
ENV OLLAMA_BASE_URL=http://192.168.112.136:11434
ENV OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b-q4
ENV OLLAMA_EMBEDDING_MODEL=nomic-embed-text
ENV OLLAMA_TEMPERATURE=0.7
ENV MAX_TOKENS=2048
ENV HF_ENDPOINT=https://hf-mirror.com
ENV JUPYTER_AI_MODEL_IDS="ollama/qwen2.5-coder:7b-q4,ollama/nomic-embed-text"
# 切换到 root 用户进行系统级安装
USER root

# ============================================
# 系统依赖安装
# ============================================
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    vim \
    nano \
    htop \
    wget \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ============================================
# 配置 Conda 环境
# ============================================
# 确保 conda 可用
ENV PATH=/opt/conda/bin:$PATH

# 初始化 conda
RUN conda init bash

# 切换到 root 用户进行文件操作
USER root
# ============================================
# 复制安装脚本文件
# ============================================
COPY --chown=jovyan:users install_persist.sh /home/jovyan/install_persist.sh
RUN   chmod +x /home/jovyan/install_persist.sh

# ============================================
# 切换到 jovyan 用户
# ============================================
USER jovyan
WORKDIR /home/jovyan
# ============================================
# 执行安装脚本
# ============================================
RUN /home/jovyan/install_persist.sh

RUN chmod +x /home/jovyan/start_jupyter_ai.sh

# ============================================
# 创建必要的目录结构
# ============================================
RUN mkdir -p /home/jovyan/work \
    /home/jovyan/notebooks \
    /home/jovyan/.jupyter \
    /home/jovyan/.ipython/profile_default/startup \
    /home/jovyan/.local/share/jupyter/kernels

# ============================================
# 设置工作目录
# ============================================
WORKDIR /home/jovyan/work

# ============================================
# 暴露端口
# ============================================
EXPOSE 8881
EXPOSE 3001
# LiteLLM Proxy 端口
EXPOSE 4000 
# ============================================
# 健康检查
# ============================================
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8881/api || exit 1

# ============================================
# 设置入口点和默认命令
# ============================================
ENTRYPOINT ["/home/jovyan/start_jupyter_ai.sh"]